// Icon and version resource. The manifest is attached by the linker.

#include "resource.h"
#include "targetver.h"
#include <windows.h>

// The one place the version is set: VER_NUMBER is the binary form, VER_TEXT the string form.
#define VER_NUMBER 1,0,0,0
#define VER_TEXT "1.0.0.0"

// Lowest icon ID goes first so Explorer picks it. The artwork is Endfield.exe's icon.
IDI_ICON                ICON                    "res\\Icons\\EndfieldLauncher.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION VER_NUMBER
  PRODUCTVERSION VER_NUMBER
  FILEFLAGSMASK 0x17L
#ifdef _DEBUG
  FILEFLAGS 0x1L
#else
  FILEFLAGS 0x0L
#endif
  FILEOS 0x4L
  FILETYPE 0x1L
  FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Genki"
            VALUE "FileDescription", "Endfield Launcher"
            VALUE "FileVersion", VER_TEXT
            VALUE "InternalName", "EndfieldLauncher"
            VALUE "LegalCopyright", "Copyright (C) 2026 Genki"
            VALUE "OriginalFilename", "EndfieldLauncher.exe"
            VALUE "ProductName", "EndfieldLauncher"
            VALUE "ProductVersion", VER_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
