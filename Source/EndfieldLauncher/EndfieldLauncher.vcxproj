    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <!-- AddressSanitizer doesn't work with /ZI or /RTC, so they're off here. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='AddressSanitizerDebug'">
